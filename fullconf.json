{
  "steps": [
    {
      "name": "System",
      "command": ["rpm-ostree", "upgrade"],
      "enabled": true
    },
    {
      "name": "Brew",
      "command": ["bash", "-c", "brew update && brew upgrade -y"],
      "enabled": true
    },
    {
      "name": "Flatpak",
      "command": ["flatpak", "update", "-y"],
      "enabled": true
    },
    {
      "name": "Distrobox",
      "command": ["distrobox-upgrade", "--all"],
      "enabled": true
    }
  ]
}
